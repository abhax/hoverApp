{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cmake",
            "label": "CMake: build",
            "command": "cleanRebuild",
            "targets": [
                "hoverApp"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "detail": "CMake template build task"
        },
        {
            "type": "shell",
            "label": "Copy Binary",
            "command": "${workspaceFolder}/scripts/copyBinary.sh 192.168.4.52",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Build and Load",
            "dependsOrder": "sequence",
            "dependsOn": ["CMake: build", "Copy Binary"]
        },
        {
            "type": "shell",
            "label": "Prepare Debug",
            "command": "${workspaceFolder}/scripts/prepare_debug.sh",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            }
        }
    ]     
} 