{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug HoverCraft",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/hoverApp",
            "cwd": "${workspaceFolder}/build",
            "stopAtEntry": true,
            "targetArchitecture": "arm64",
            "launchCompleteCommand": "exec-run",
            "preLaunchTask": "Copy Binary",
            "symbolLoadInfo":{
                "loadAll": true,
                "exceptionList": ""
            },
            "linux": {
                "MIMode": "gdb",
                "miDebuggerPath": "/opt/poky/3.4.4/sysroots/x86_64-pokysdk-linux/usr/bin/aarch64-poky-linux/aarch64-poky-linux-gdb",
                "miDebuggerServerAddress": "192.168.4.52:3000",
                "setupCommands": [
                    {
                        "text": "set sysroot /opt/poky/3.4.4/sysroots/aarch64-poky-linux",
                        "description": "Set sysroot",
                        "ignoreFailures": false
                    }
                ]
            }
        },
        {
            "name": "Debug with Manual Preparation",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/hoverApp",
            "cwd": "${workspaceFolder}/build",
            "stopAtEntry": true,
            "targetArchitecture": "arm64",
            "launchCompleteCommand": "exec-run",
            "preLaunchTask": "Prepare Debug",
            "linux": {
                "MIMode": "gdb",
                "miDebuggerPath": "/opt/poky/3.4.4/sysroots/x86_64-pokysdk-linux/usr/bin/aarch64-poky-linux/aarch64-poky-linux-gdb",
                "miDebuggerServerAddress": "192.168.4.52:3000",
                "setupCommands": [
                    {
                        "text": "set sysroot /opt/poky/3.4.4/sysroots/aarch64-poky-linux",
                        "description": "Set sysroot",
                        "ignoreFailures": false
                    },
                    {
                        "text": "set print pretty on",
                        "description": "Enable pretty printing",
                        "ignoreFailures": true
                    },
                    {
                        "text": "set print thread-events off",
                        "description": "Reduce noise from threading",
                        "ignoreFailures": true
                    }
                ]
            }
        }
    ]
}